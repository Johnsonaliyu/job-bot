# ── WhatsApp ──────────────────────────────────────────────────────────────────
# Phone number the bot runs on (international format, no +)
BOT_PHONE_NUMBER=2348012345678

# Your number to receive application notifications
OWNER_NOTIFY_NUMBER=2348012345678

# Where to store WhatsApp session files
AUTH_FOLDER=./auth_info

# ── AI (Groq primary, Nvidia fallback) ────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your@gmail.com
SMTP_PASS=                        # Gmail App Password (16-char)
FROM_NAME=Your Full Name

# ── Google Drive — CV files ───────────────────────────────────────────────────
# Folder ID from the Drive URL: drive.google.com/drive/folders/<FOLDER_ID>
CV_DRIVE_FOLDER_ID=

# ── Google Sheets — application log ──────────────────────────────────────────
LOG_SHEET_ID=
LOG_SHEET_TAB=Applications

# ── Google Service Account ────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
